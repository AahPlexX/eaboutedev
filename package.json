{
  "name": "everything-about-development",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": "11.20.0"
  },
  "scripts": {
    "dev": "vite",
    "generate": "node scripts/generate-content-artifacts.mjs",
    "validate:content": "node scripts/validate-content.mjs",
    "validate:versions": "node scripts/validate-exact-versions.mjs",
    "validate:discovery": "node scripts/validate-discovery-assets.mjs",
    "test": "node --test --experimental-strip-types tests/**/*.test.ts",
    "typecheck": "tsc -b",
    "lint": "oxlint . --deny-warnings",
    "build": "pnpm run generate && pnpm run validate:content && pnpm run validate:versions && pnpm run check:generated && pnpm run validate:discovery && tsc -b && vite build",
    "check": "pnpm run generate && pnpm run validate:content && pnpm run validate:versions && pnpm run check:generated && pnpm run validate:discovery && pnpm run test && pnpm run typecheck && pnpm run lint && pnpm run build",
    "preview": "vite preview",
    "check:generated": "node scripts/generate-content-artifacts.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.31.0",
    "minisearch": "7.2.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.2",
    "tailwind-merge": "3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxlint": "1.78.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
